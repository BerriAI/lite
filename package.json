{
  "name": "@litellm/litespeed",
  "version": "0.1.10",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Litespeed — a local coding agent with multi-model workflows for your terminal and browser.",
  "repository": { "type": "git", "url": "git+https://github.com/BerriAI/litespeed.git" },
  "homepage": "https://github.com/BerriAI/litespeed#readme",
  "bugs": { "url": "https://github.com/BerriAI/litespeed/issues" },
  "engines": {
    "node": ">=26.4.0"
  },
  "bin": {
    "litespeed": "bin/litespeed.mjs"
  },
  "scripts": {
    "preinstall": "node bin/check-node.mjs",
    "postinstall": "node scripts/prepare-terminal.mjs",
    "dev": "tsx watch server/index.ts",
    "tui": "node bin/litespeed.mjs",
    "package:macos": "npm run build && node scripts/release/package.mjs",
    "test:package": "node scripts/release/smoke.mjs",
    "migrate": "node scripts/migrate-state.mjs",
    "build": "vite build && tsup",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "test:tui": "node scripts/test-tui.mjs",
    "test:tui:queue": "node scripts/test-tui-queue.mjs",
    "test:tui:flow": "node scripts/test-tui-flow.mjs",
    "test:tui:interactions": "node scripts/test-tui-interactions.mjs",
    "test:tui:startup": "npm run build && node scripts/test-tui-startup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bun": "^1.4.2",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/headless": "^6.0.0",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
