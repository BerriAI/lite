{
  "name": "@litellm/lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A thoughtful, local-first coding harness for LiteLLM and your favorite models.",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "lite": "bin/lite.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs",
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --external vite",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
